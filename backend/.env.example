# Backend Production Environment Variables
PORT=5000
NODE_ENV=production

# URLs
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend-api.onrender.com

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/amice_amarine?retryWrites=true&w=majority

# Security Keys
JWT_SECRET=your_super_secret_jwt_random_key_min_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_random
ADMIN_SECRET_KEY=your_secure_admin_creation_key

# Cloudinary Media Storage (optional for product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Store Policies
STORE_NAME="Amice Amarine"
STORE_CURRENCY=INR
STORE_FREE_SHIPPING_THRESHOLD=999
STORE_STANDARD_SHIPPING_FEE=99
STORE_COD_ENABLED=true
STORE_COD_FEE=50
