# ===========================================
# AMICE AMARINE E-COMMERCE CONFIGURATION
# ===========================================

# Server & Client URLs
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# MongoDB Database URI
MONGODB_URI=mongodb://127.0.0.1:27017/amice_amarine

# Authentication & Security
JWT_SECRET=super_secret_amice_amarine_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_secret_change_in_production_2026
ADMIN_SECRET_KEY=admin_access_token_secure_setup_2026

# Payment Gateway (Razorpay for India)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Optional Stripe Integration
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Media Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Store Defaults
STORE_NAME="Amice Amarine"
STORE_CURRENCY=INR
STORE_FREE_SHIPPING_THRESHOLD=999
STORE_STANDARD_SHIPPING_FEE=99
STORE_COD_ENABLED=true
STORE_COD_FEE=50
